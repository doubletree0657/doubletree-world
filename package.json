{
  "name": "doubletree-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "pnpm types && astro check && tsc --project tsconfig.worker.json",
    "types": "wrangler types",
    "build": "astro build",
    "preview": "wrangler dev --local --ip 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "test:runtime": "pnpm build && node --test tests/runtime.test.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "wrangler": "4.153.0"
  },
  "packageManager": "pnpm@11.25.0"
}
