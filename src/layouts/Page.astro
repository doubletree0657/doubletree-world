---
import '../styles/global.css';
interface Props { lang: string; title?: string; description: string; locale?: 'en' | 'zh'; }
const { lang, title = "DoubleTree's World", description, locale } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101b32" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {locale && <>
      <link rel="canonical" href={`https://doubletree.world/${locale}/`} />
      <link rel="alternate" hreflang="en" href="https://doubletree.world/en/" />
      <link rel="alternate" hreflang="zh-CN" href="https://doubletree.world/zh/" />
      <link rel="alternate" hreflang="x-default" href="https://doubletree.world/" />
      <meta property="og:url" content={`https://doubletree.world/${locale}/`} />
      <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    </>}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body><slot /></body>
</html>
