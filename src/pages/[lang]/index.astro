---
import { Image } from 'astro:assets';
import Page from '../../layouts/Page.astro';
import { content } from '../../i18n/content';
import { YORUSHIKA } from '../../i18n/yorushika';
import stage from '../../../assets/yorushika/albums/dakara-boku-wa-ongaku-wo-yameta/songs/dakara-boku-wa-ongaku-wo-yameta/live/user-upload-2026-11-01/originals/05-stage-wide-blue.png';
import vocal from '../../../assets/yorushika/albums/dakara-boku-wa-ongaku-wo-yameta/songs/dakara-boku-wa-ongaku-wo-yameta/live/user-upload-2026-11-01/originals/01-vocal-closeup-amber.png';
import writing from '../../../assets/yorushika/albums/dakara-boku-wa-ongaku-wo-yameta/songs/dakara-boku-wa-ongaku-wo-yameta/live/user-upload-2026-11-01/originals/03-handwriting-black.png';
import windowScene from '../../../assets/yorushika/albums/dakara-boku-wa-ongaku-wo-yameta/songs/dakara-boku-wa-ongaku-wo-yameta/live/user-upload-2026-11-01/originals/02-window-desk-projection.png';
export function getStaticPaths() { return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }]; }
const locale = Astro.params.lang as 'en' | 'zh';
const t = content[locale];
const song = YORUSHIKA.songs.dakara;
---
<Page lang={t.lang} description={t.description} locale={locale}>
  <a class="skip" href="#main">{t.skip}</a>
  <header class="masthead">
    <a class="wordmark" href="#opening">doubletree<span class="brand-star">✳</span></a>
    <a class="header-about" href="#about">{t.about} ↗</a>
    <nav class="languages" aria-label={t.language}>
      <a href="/language?lang=zh" lang="zh-CN" aria-current={locale === 'zh' ? 'page' : undefined}>中</a><span>/</span><a href="/language?lang=en" lang="en" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
    </nav>
  </header>
  <main id="main">
    <section class="opening" id="opening" aria-labelledby="song-title">
      <Image class="stage-image" src={stage} alt={t.imageStage} widths={[800, 1440, 2200]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" />
      <div class="opening-shade"></div>
      <div class="opening-top"><span>01 / DOUBLETREE’S WORLD</span><span>{t.artist} — LIVE FRAGMENTS</span></div>
      <div class="song-heading">
        <p class="artist">{t.artist}</p>
        <h1 id="song-title" lang="ja" aria-label={song.title}><span>だから僕は</span><span class="title-bottom">音楽を辞めた<span class="title-period">。</span></span></h1>
        <div class="title-rule"><span>2019 — 04 — 10</span><span>Ⅰ</span></div>
      </div>
      <div class="opening-bottom">
        <p class="monologue">{t.monologueFirst}<br />{t.monologueBefore}<em>{t.monologueBand}</em>{t.monologueAfter}</p>
      </div>
      <span class="edge-title" lang="ja">{song.title}</span>
    </section>

    <section class="resentment chapter" id="resentment" aria-labelledby="resentment-title">
      <div class="chapter-label"><span>01</span><span>{t.artist} / {song.title}</span><span>↘</span></div>
      <div class="resentment-composition">
        <figure class="vocal-frame"><Image src={vocal} alt={t.imageVocal} widths={[700, 1200, 1800]} sizes="(max-width: 700px) 100vw, 66vw" format="webp" /><figcaption>LIVE STILL / 01</figcaption></figure>
        <h2 id="resentment-title" class="hate-copy reveal"><span>{t.hateFirst}</span><strong>{t.hateSecond}</strong></h2>
        <div class="self-copy reveal"><span class="small-cross">＋</span><p>{t.selfFirst}<br />{t.selfSecond}</p></div>
      </div>
    </section>

    <section class="inferiority" aria-label={t.imageWriting}>
      <div class="writing-frame"><Image src={writing} alt={t.imageWriting} widths={[800, 1400]} sizes="(max-width: 700px) 100vw, 75vw" format="webp" /></div>
      <span class="margin-number">02 / INNER NOISE</span>
      <p class="inferiority-caption">{t.selfSecond}</p>
    </section>

    <section class="rejection chapter" aria-labelledby="rejection-title">
      <div class="chapter-label"><span>03</span><span>{t.artist} / {song.title}</span><span>↘</span></div>
      <div class="scattered-words" aria-label={t.words.join('、')}>
        {t.words.map((word, i) => <span class={`word word-${i}`} aria-hidden="true">{word}<small>0{i + 1}</small></span>)}
      </div>
      <div class="disgust-block reveal"><p>{t.reason}</p><h2 id="rejection-title">{t.disgust}</h2></div>
      <p class="question reveal">{t.questionFirst}<br /><span>{t.questionSecond}</span></p>
    </section>

    <section class="indifference" aria-labelledby="ending-title">
      <p class="word-stream">{t.indifferent.map(word => <span>{word}<b aria-hidden="true"> / </b></span>)}</p>
      <h2 id="ending-title" class="reveal">{t.ending}</h2>
      <div class="end-marker"><span>04</span><span>●</span><span>END OF SIDE A</span></div>
    </section>

    <section class="afterimage" id="about" aria-labelledby="about-title">
      <figure class="window-frame"><Image src={windowScene} alt={t.imageWindow} widths={[800, 1440, 2000]} sizes="100vw" format="webp" /></figure>
      <div class="about-content"><p class="eyebrow">{t.personal}</p><h2 id="about-title">DoubleTree<span>．</span></h2><p class="about-intro">{t.intro}</p><p class="interests">{t.interests}</p></div>
      <footer><a href="#opening">{t.back} ↑</a><span>{t.note}</span><a href={song.officialVideoPageUrl} target="_blank" rel="noreferrer">{t.artist} ↗</a></footer>
    </section>
  </main>
  <script>
    const elements = document.querySelectorAll('.reveal');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        for (const entry of entries) if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
      }, { threshold: 0.12 });
      elements.forEach(el => { el.classList.add('will-reveal'); observer.observe(el); });
    }
  </script>
</Page>
